{
  "name": "shipdot-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @shipdot/docs dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build:action": "pnpm --filter @shipdot/action build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter shipdot build && playwright test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "size": "size-limit",
    "docs": "pnpm --filter @shipdot/docs dev",
    "docs:build": "pnpm --filter @shipdot/docs build",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-cdn-version.ts && pnpm install --lockfile-only && pnpm --filter \"@shipdot/action...\" build",
    "release": "pnpm build:packages && changeset publish"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.4",
    "happy-dom": "^21.0.1",
    "size-limit": "^14.2.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
