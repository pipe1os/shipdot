---
// Live playground: edit entries on the left, see <ship-dot> and its hotspots on a fake app.
const bars = [38, 52, 45, 61, 58, 72, 66, 80, 74, 88, 83, 96]
---

<div class="pg not-content" data-playground>
  <section class="pg-editor" aria-labelledby="pg-editor-title">
    <div class="pg-editor-head">
      <h2 id="pg-editor-title">Entries</h2>
      <div class="pg-buttons">
        <button type="button" class="pg-btn pg-btn-ghost" data-action="restore">Restore samples</button>
        <button type="button" class="pg-btn pg-btn-ghost" data-action="copy">Copy link</button>
        <button type="button" class="pg-btn" data-action="add">Add entry</button>
      </div>
    </div>
    <div class="pg-status" data-status role="status" aria-live="polite"></div>
    <div class="pg-entries" data-entries></div>
    <details class="pg-output" data-output="feed">
      <summary>Generated <code>shipdot.json</code></summary>
      <pre></pre>
    </details>
    <details class="pg-output" data-output="llms">
      <summary>Generated <code>llms.txt</code></summary>
      <pre></pre>
    </details>
    <template data-entry-template>
      <div class="pg-entry" data-entry>
        <div class="pg-entry-head">
          <label class="pg-filename">
            <span class="pg-sr">File name</span>
            <input type="text" spellcheck="false" autocomplete="off" />
          </label>
          <button type="button" class="pg-remove" data-remove aria-label="Remove entry">×</button>
        </div>
        <textarea rows="8" spellcheck="false"></textarea>
      </div>
    </template>
  </section>

  <section class="pg-preview" aria-label="Preview">
    <div class="pg-controls">
      <label>Mode
        <select data-control="mode">
          <option value="popover">popover</option>
          <option value="drawer">drawer</option>
          <option value="modal">modal</option>
        </select>
      </label>
      <label>Theme
        <select data-control="theme">
          <option value="auto">auto</option>
          <option value="light">light</option>
          <option value="dark">dark</option>
        </select>
      </label>
      <label>Locale
        <select data-control="locale">
          <option value="">browser</option>
          <option value="en">en</option>
          <option value="es">es</option>
          <option value="pt">pt</option>
        </select>
      </label>
      <label>Brand
        <input type="color" data-control="brand" value="#0f766e" />
      </label>
      <button type="button" class="pg-btn pg-btn-ghost" data-action="reset">Mark all unread</button>
    </div>
    <div class="pg-window" data-app data-theme="light" data-ui>
      <div class="pg-chrome" aria-hidden="true">
        <div class="pg-url">app.acme.example/reports/revenue</div>
      </div>
      <div class="pg-app">
        <header class="pg-top">
          <div class="pg-brand"><span class="pg-mark"></span>Acme Analytics</div>
          <nav class="pg-nav" aria-label="Demo app">
            <span class="is-active">Reports</span>
            <span>Customers</span>
            <span>Settings</span>
          </nav>
          <ship-dot storage-key="playground" class="pg-widget"></ship-dot>
        </header>
        <main class="pg-main">
          <div class="pg-head">
            <div>
              <p class="pg-crumb">Reports</p>
              <p class="pg-title">Revenue overview</p>
            </div>
            <div class="pg-actions">
              <button type="button" id="btn-filter">Filter</button>
              <button type="button" id="btn-share">Share</button>
              <button type="button" id="btn-export" class="is-primary">Export</button>
            </div>
          </div>
          <div class="pg-kpis">
            <div><p>Revenue</p><strong>$48.2k</strong><span class="up">+12.4%</span></div>
            <div><p>Orders</p><strong>1,284</strong><span class="up">+3.1%</span></div>
            <div><p>Refunds</p><strong>0.8%</strong><span class="down">−0.2%</span></div>
          </div>
          <div class="pg-chart" aria-hidden="true">
            {bars.map((h) => <span style={`--h:${h}%`}></span>)}
          </div>
        </main>
      </div>
    </div>
    <p class="pg-hint">
      The pulsing dots are <strong>hotspots</strong>: entries with a <code>target</code> point at the
      real buttons. Click one, or open the bell. The brand color reaches the widget through <code>--shipdot-accent</code>.
    </p>
  </section>
</div>

<script>
  import { mountPlayground } from '../playground/playground'

  const root = document.querySelector<HTMLElement>('[data-playground]')
  if (root) void mountPlayground(root)
</script>

<style is:global>
  .pg {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 1.5rem 2rem;
    align-items: start;
    margin-top: 1.5rem;
  }
  .pg-sr {
    position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
  }
  .pg-editor { display: grid; gap: 0.75rem; }
  .pg-editor-head { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; align-items: center; justify-content: space-between; }
  .pg-editor-head h2 { margin: 0; font-size: var(--sl-text-h4); }
  .pg-buttons { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .pg-controls { display: flex; flex-wrap: wrap; gap: 0.5rem 0.75rem; align-items: end; margin-bottom: 0.75rem; }
  .pg-controls label { display: grid; gap: 0.2rem; font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); }
  .pg-controls select, .pg-controls input {
    font: inherit; font-size: var(--sl-text-sm); height: 2.1rem; padding: 0 0.5rem; border-radius: 0.4rem;
    border: 1px solid var(--sl-color-gray-5); background: var(--sl-color-black); color: var(--sl-color-white);
  }
  .pg-controls input[type='color'] { width: 3rem; padding: 0.2rem; cursor: pointer; }
  .pg-controls .pg-btn { margin-left: auto; }
  /* Same tokens as Starlight's primary link button, which keep AA contrast in both themes. */
  .pg-btn {
    font: inherit; font-size: var(--sl-text-sm); font-weight: 600; cursor: pointer; height: 2.1rem;
    padding: 0 0.85rem; border-radius: 0.4rem; border: 1px solid var(--sl-color-text-accent);
    background: var(--sl-color-text-accent); color: var(--sl-color-black);
    transition: transform 120ms ease, background-color 120ms ease;
  }
  .pg-btn:hover { background: var(--sl-color-white); border-color: var(--sl-color-white); }
  .pg-btn:active { transform: translateY(1px); }
  .pg-btn-ghost { background: transparent; color: var(--sl-color-text-accent); border-color: var(--sl-color-gray-5); }
  .pg-btn-ghost:hover { background: var(--sl-color-gray-6); border-color: var(--sl-color-gray-5); }
  @media (prefers-reduced-motion: reduce) {
    .pg-btn { transition: none; }
    .pg-btn:active { transform: none; }
  }
  .pg-btn:focus-visible, .pg-remove:focus-visible, .pg-entry input:focus-visible,
  .pg-entry textarea:focus-visible, .pg-controls select:focus-visible, .pg-controls input:focus-visible,
  .pg-output summary:focus-visible {
    outline: 2px solid var(--sl-color-text-accent); outline-offset: 2px;
  }
  .pg-status { font-size: var(--sl-text-sm); border-radius: 0.5rem; padding: 0.6rem 0.8rem; background: var(--sl-color-gray-6); }
  .pg-status p { margin: 0; font-weight: 600; }
  .pg-status[data-state='ok'] p { color: var(--sl-color-green-high); }
  .pg-status[data-state='error'] p { color: var(--sl-color-red-high); }
  .pg-status ul { margin: 0.4rem 0 0; padding-left: 1.1rem; font-family: var(--__sl-font-mono); font-size: var(--sl-text-xs); }
  .pg-status li[data-severity='error'] { color: var(--sl-color-red-high); }
  .pg-status li[data-severity='warning'] { color: var(--sl-color-orange-high); }
  .pg-entries { display: grid; gap: 0.75rem; }
  .pg-entry { border: 1px solid var(--sl-color-gray-5); border-radius: 0.6rem; overflow: hidden; background: var(--sl-color-black); }
  .pg-entry:focus-within { border-color: var(--sl-color-gray-3); }
  .pg-entry-head { display: flex; align-items: center; background: var(--sl-color-gray-6); }
  .pg-filename { flex: 1; }
  .pg-entry input {
    width: 100%; box-sizing: border-box; border: 0; background: transparent; color: var(--sl-color-white);
    font-family: var(--__sl-font-mono); font-size: var(--sl-text-sm); padding: 0.5rem 0.75rem;
  }
  .pg-remove {
    border: 0; background: transparent; color: var(--sl-color-gray-2); font-size: 1.25rem; line-height: 1;
    width: 2.25rem; height: 2.25rem; cursor: pointer; border-radius: 0.4rem;
  }
  .pg-remove:hover { color: var(--sl-color-white); background: var(--sl-color-gray-5); }
  .pg-entry textarea {
    display: block; width: 100%; box-sizing: border-box; resize: vertical; border: 0; margin: 0;
    padding: 0.6rem 0.75rem; background: transparent; color: var(--sl-color-white);
    font-family: var(--__sl-font-mono); font-size: var(--sl-text-sm); line-height: 1.6; tab-size: 2;
    /* Grows with its content where supported; long entries scroll. */
    field-sizing: content; min-height: 5lh; max-height: 32rem;
  }
  .pg-output summary { cursor: pointer; font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); }
  .pg-output pre {
    max-height: 20rem; overflow: auto; font-size: var(--sl-text-xs); padding: 0.75rem; margin: 0.5rem 0 0;
    border-radius: 0.5rem; background: var(--sl-color-gray-6); white-space: pre-wrap; overflow-wrap: anywhere;
  }
  .pg-preview { position: sticky; top: calc(var(--sl-nav-height) + 1rem); }
  @media (max-width: 960px) {
    .pg { grid-template-columns: minmax(0, 1fr); }
    /* On one column the result comes first: it is what the edits are for. */
    .pg-preview { order: -1; position: static; }
  }
  .pg-hint { font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); margin: 0.75rem 0 0; max-width: 65ch; }

  /* The fake app: its own palette, independent from the docs theme. --brand can be overridden. */
  .pg-window {
    --bg: #ffffff; --panel: #f4f6f8; --fg: #0f172a; --muted: #475569; --line: #e2e8f0;
    --brand: #0f766e; --brand-fg: #ffffff; --up: #047857; --down: #b91c1c;
    --bar: color-mix(in srgb, var(--brand) 30%, var(--panel));
    border-radius: 0.9rem; overflow: hidden; border: 1px solid var(--line); background: var(--bg); color: var(--fg);
    font: 14px/1.5 system-ui, -apple-system, 'Segoe UI', sans-serif;
  }
  .pg-window[data-theme='dark'] {
    --bg: #0b1120; --panel: #131b2c; --fg: #e5e7eb; --muted: #9ca3af; --line: #1f2937;
    --brand: #2dd4bf; --brand-fg: #042f2e; --up: #34d399; --down: #f87171;
  }
  .pg-chrome { padding: 0.55rem 0.8rem; background: var(--panel); }
  .pg-url {
    max-width: 22rem; font-size: 13px; color: var(--muted); background: var(--bg);
    border-radius: 999px; padding: 0.15rem 0.75rem;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .pg-top { display: flex; align-items: center; gap: 1.25rem; padding: 0.6rem 1rem; border-bottom: 1px solid var(--line); }
  .pg-brand { display: flex; align-items: center; gap: 0.5rem; font-weight: 700; white-space: nowrap; flex: 1; }
  .pg-mark { width: 1.1rem; height: 1.1rem; border-radius: 0.35rem; background: var(--brand); }
  .pg-nav { display: flex; gap: 1rem; color: var(--muted); font-size: 13px; }
  .pg-nav .is-active { color: var(--fg); font-weight: 600; }
  .pg-widget { color: var(--fg); --shipdot-accent: var(--brand); --shipdot-accent-contrast: var(--brand-fg); }
  .pg-main { padding: 1.25rem 1rem 1.5rem; display: grid; gap: 1.1rem; }
  .pg-head { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: end; justify-content: space-between; }
  .pg-crumb { margin: 0; font-size: 13px; color: var(--muted); }
  .pg-title { margin: 0; font-size: 18px; font-weight: 700; }
  .pg-actions { display: flex; gap: 0.5rem; }
  .pg-actions button {
    font: inherit; font-size: 13px; font-weight: 600; padding: 0.4rem 0.85rem; border-radius: 0.5rem;
    border: 1px solid var(--line); background: var(--bg); color: var(--fg); cursor: pointer;
  }
  .pg-actions .is-primary { background: var(--brand); border-color: var(--brand); color: var(--brand-fg); }
  .pg-actions button:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  .pg-kpis { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; }
  .pg-kpis > div { border-radius: 0.6rem; padding: 0.7rem 0.8rem; background: var(--panel); }
  .pg-kpis p { margin: 0; font-size: 13px; color: var(--muted); }
  .pg-kpis strong { display: block; font-size: 20px; }
  .pg-kpis .up { color: var(--up); font-size: 13px; font-weight: 600; }
  .pg-kpis .down { color: var(--down); font-size: 13px; font-weight: 600; }
  .pg-chart { display: flex; align-items: end; gap: 0.45rem; height: 9rem; padding: 0.9rem; border-radius: 0.6rem; background: var(--panel); }
  .pg-chart span { flex: 1; height: var(--h); border-radius: 0.3rem 0.3rem 0 0; background: var(--bar); }
  .pg-chart span:last-child { background: var(--brand); }
  @media (max-width: 560px) {
    .pg-nav { display: none; }
    .pg-kpis { grid-template-columns: 1fr; }
  }
</style>
